at) -> float:\n        for _ in range(1000):\n            m = (a + b) / 2.0\n\n            if m == a or m == b:\n                break\n\n            if abs(b - a) <= 1e-12 * max(1.0, abs(a), abs(b)):\n                break\n\n            fm = f(m)\n            if fm == 0.0:\n                return m\n\n            if sign(fa) * sign(fm) < 0:\n                b, fb = m, fm\n            else:\n                a, fa = m, fm\n\n        return (a + b) / 2.0\n\n    # Check x = 0 first.\n    f0 = f(0.0)\n    if f0 == 0.0:\n        return 0.0\n\n    # Find a bracketing interval [-R, R] where the signs differ.\n    a, b = -1.0, 1.0\n    fa, fb = f(a), f(b)\n\n    if fa == 0.0:\n        return a\n    if fb == 0.0:\n        return b\n\n    for _ in range(1024):\n        if sign(fa) * sign(fb) < 0:\n            return bisect(a, b, fa, fb)\n\n        a *= 2.0\n        b *= 2.0\n\n        if not (math.isfinite(a) and math.isfinite(b)):\n            break\n\n        fa, fb = f(a), f(b)\n\n        if fa == 0.0:\n            return a\n        if fb == 0.0:\n            return b\n\n    # Fallback: scan a reasonable finite interval for a sign change.\n    prev_x = -1000.0\n    prev_f = f(prev_x)\n\n    if prev_f == 0.0:\n        return prev_x\n\n    for i in range(1, 1001):\n        x = -1000.0 + 2.0 * i\n        fx = f(x)\n\n        if fx == 0.0:\n            return x\n\n        if sign(prev_f) * sign(fx) < 0:\n            return bisect(prev_x, x, prev_f, fx)\n\n        prev_x, prev_f = x, fx\n\n    # Should not be reached for the guaranteed input class.\n    return 0.0\n```", "has_separate_reasoning_field": true, "has_inline_think_tag": false, "wall_s": 1988.8, "requested_extra_body": {"chat_template_kwargs": {"reasoning_effort": "xhigh"}}, "resolved_reasoning_effort": "xhigh", "resolved_reasoning_effort_source": "requested"}
