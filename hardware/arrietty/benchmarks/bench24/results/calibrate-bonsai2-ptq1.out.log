nomial changes sign.\n    a, b = -1.0, 1.0\n    pa, pb = poly(coeffs, a), poly(coeffs, b)\n\n    if is_zero(pa):\n        return a\n    if is_zero(pb):\n        return b\n\n    sa, sb = sign(pa), sign(pb)\n    bracket_found = False\n\n    for _ in range(100):\n        if sa == 0 or sb == 0:\n            break\n\n        if sa * sb <= 0:\n            bracket_found = True\n            break\n\n        b *= 2.0\n        a = -b\n\n        pa = poly(coeffs, a)\n        pb = poly(coeffs, b)\n\n        if is_zero(pa):\n            return a\n        if is_zero(pb):\n            return b\n\n        sa, sb = sign(pa), sign(pb)\n\n        if sa == 0 or sb == 0:\n            break\n\n    if not bracket_found:\n        # Fallback: try Newton's method from several starting points.\n        deriv = [i * c for i, c in enumerate(coeffs) if i > 0]\n\n        def newton(start: float):\n            x = float(start)\n\n            for _ in range(100):\n                fx = poly(coeffs, x)\n                if is_zero(fx):\n                    return x\n\n                dfx = poly(deriv, x)\n                if is_zero(dfx) or math.isnan(dfx) or math.isinf(dfx):\n                    break\n\n                step = fx / dfx\n                if math.isnan(step) or math.isinf(step):\n                    break\n\n                x -= step\n\n                if math.isnan(x) or math.isinf(x):\n                    break\n\n            return x if is_zero(poly(coeffs, x)) else None\n\n        starts = [0.0, 1.0, -1.0, 2.0, -2.0, 10.0, -10.0, 100.0, -100.0]\n\n        lead = coeffs[-1]\n        if lead != 0.0:\n            scale = 0.0\n            for c in coeffs[:-1]:\n                try:\n                    ratio = abs(c / lead)\n                except (OverflowError, ZeroDivisionError):\n                    ratio = float(\"inf\")\n\n                if math.isfinite(ratio):\n                    scale = max(scale, ratio)\n\n            if math.isfinite(scale):\n                starts.extend([scale, -scale, scale * 10.0, -scale * 10.0])\n\n        best = None\n        for s in starts:\n            r = newton(s)\n            if r is not None and math.isfinite(r):\n                if best is None or abs(r) < abs(best):\n                    best = r\n\n        if best is not None:\n            return best\n\n        return 0.0\n\n    # Bisection on the found sign-changing interval.\n    for _ in range(100):\n        c = (a + b) / 2.0\n        pc = poly(coeffs, c)\n\n        if math.isnan(pc):\n            break\n\n        if is_zero(pc):\n            return c\n\n        sc = sign(pc)\n        if sc == 0:\n            return c\n\n        if sa * sc <= 0:\n            b = c\n            sb = sc\n        else:\n            a = c\n            sa = sc\n\n        if b - a < 1e-12:\n            break\n\n    return (a + b) / 2.0\n```", "has_separate_reasoning_field": true, "has_inline_think_tag": false, "wall_s": 658.5, "requested_extra_body": {"chat_template_kwargs": {"reasoning_effort": "xhigh"}}, "resolved_reasoning_effort": "xhigh", "resolved_reasoning_effort_source": "requested"}
