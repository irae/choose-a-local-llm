t immediately.\n    if _eval_poly(coeffs, 0.0) == 0.0:\n        return 0.0\n\n    # Find a symmetric interval [-M, M] where the polynomial changes sign.\n    M = 1.0\n    a = b = fa = fb = None\n\n    for _ in range(1000):\n        a = -M\n        b = M\n        fa = _eval_poly(coeffs, a)\n        fb = _eval_poly(coeffs, b)\n\n        if fa == 0.0:\n            return a\n        if fb == 0.0:\n            return b\n\n        if _sign(fa) * _sign(fb) < 0:\n            break\n\n        M *= 2.0\n        if not math.isfinite(M):\n            break\n\n    # Fallback for pathological numerical cases: try Newton's method.\n    if a is None or _sign(fa) * _sign(fb) >= 0:\n        deriv = [i * coeff for i, coeff in enumerate(coeffs) if i > 0]\n\n        for start in (0.0, 1.0, -1.0, 2.0, -2.0, 10.0, -10.0, 100.0, -100.0):\n            x = start\n            for _ in range(200):\n                fx = _eval_poly(coeffs, x)\n                if fx == 0.0:\n                    return x\n\n                dfx = _eval_poly(deriv, x)\n                if dfx == 0.0:\n                    break\n\n                x_new = x - fx / dfx\n                if not math.isfinite(x_new):\n                    break\n\n                if abs(x_new - x) <= 1e-12 * max(1.0, abs(x_new)):\n                    return x_new\n\n                x = x_new\n\n        if a is not None and b is not None:\n            return (a + b) / 2.0\n        return 0.0\n\n    # Bisection on the bracketed interval.\n    for _ in range(2000):\n        m = (a + b) / 2.0\n        fm = _eval_poly(coeffs, m)\n\n        if fm == 0.0:\n            return m\n        if math.isnan(fm):\n            break\n        if (b - a) <= 1e-12 * max(1.0, abs(m)):\n            return m\n\n        if _sign(fa) * _sign(fm) <= 0:\n            b = m\n        else:\n            a = m\n            fa = fm\n\n    return (a + b) / 2.0\n```", "has_separate_reasoning_field": true, "has_inline_think_tag": false, "wall_s": 859.5, "requested_extra_body"