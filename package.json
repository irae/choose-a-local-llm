{
  "name": "choose-a-local-llm",
  "version": "1.0.0",
  "private": true,
  "description": "Finding the best local coding model for your machine",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "verify": "npm run build && node tools/check-links.mjs",
    "deploy": "./scripts/publish.sh",
    "docs:dev": "npm run dev",
    "docs:build": "npm run build",
    "docs:preview": "npm run preview",
    "docs:tables": "node tools/gen-tables.mjs",
    "docs:check": "node tools/gen-tables.mjs --check && node tools/check-links.mjs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
